@{
    ViewData["Title"] = "Reports & Statistics";
    Layout = "_AdminLayout";

    var labBookings = ViewBag.LabBookings as IEnumerable<dynamic>;
    int totalBookings = ViewBag.TotalBookings != null ? (int)ViewBag.TotalBookings : 0;
    string mostUsedLab = ViewBag.MostUsedLab as string ?? "N/A";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-50 min-h-screen p-4 md:p-8">

    <div class="max-w-7xl mx-auto">
        <!-- Page Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">Lab Reports & Statistics</h1>
                <p class="text-gray-600 mt-2">Comprehensive overview of lab utilization and equipment</p>
            </div>
            <div class="mt-4 md:mt-0">
                <div class="bg-white p-3 rounded-lg shadow-sm border border-gray-200">
                    <p class="text-sm text-gray-600">Reporting period: <span class="font-medium">Current Semester</span></p>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-5 rounded-xl shadow-sm border border-blue-100">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-blue-50 text-blue-600 mr-4">
                        <i class="fas fa-calendar-check text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Total Bookings</p>
                        <h3 class="text-2xl font-bold text-gray-800">@totalBookings</h3>
                    </div>
                </div>
            </div>
            
            <div class="bg-white p-5 rounded-xl shadow-sm border border-green-100">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-green-50 text-green-600 mr-4">
                        <i class="fas fa-flask text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Active Labs</p>
                        <h3 class="text-2xl font-bold text-gray-800">@(labBookings?.Count() ?? 0)</h3>
                    </div>
                </div>
            </div>
            
            <div class="bg-white p-5 rounded-xl shadow-sm border border-purple-100">
                <div class="flex items-center">
                    <div class="p-3 rounded-full bg-purple-50 text-purple-600 mr-4">
                        <i class="fas fa-star text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Most Used Lab</p>
                        <h3 class="text-xl font-bold text-gray-800 truncate">@mostUsedLab</h3>
                    </div>
                </div>
            </div>
        </div>

      

        <!-- Labs List -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold text-gray-800">Lab Details</h3>
                <div class="relative">
                    <input type="text" placeholder="Search labs..." class="pl-8 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                </div>
            </div>

            @if (labBookings != null && labBookings.Any())
            {
                <div class="grid grid-cols-1 gap-6">
                    @foreach (var item in labBookings)
                    {
                        var lab = item.Lab as AAUP_LabMaster.Models.Lab;
                        var bookingCount = item.BookingCount;
                        var equipmentList = lab.Equipment as List<AAUP_LabMaster.Models.Equipment>;
                        var percentage = totalBookings > 0 ? (bookingCount * 100 / totalBookings) : 0;

                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300">
                            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center mb-2">
                                        <div class="p-2 rounded-lg bg-blue-50 text-blue-600 mr-3">
                                            <i class="fas fa-flask text-lg"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-lg font-bold text-gray-800">@lab.Name</h4>
                                            <p class="text-sm text-gray-600">@lab.Description</p>
                                        </div>
                                    </div>
                                    <div class="ml-11">
                                        <div class="flex items-center text-sm text-gray-500 mb-1">
                                            <i class="fas fa-user-tie mr-2"></i>
                                            <span>Supervisor: @lab.Supervisour?.FullName</span>
                                        </div>
                                        <div class="flex items-center text-sm text-gray-500">
                                            <i class="fas fa-microchip mr-2"></i>
                                            <span>Equipment: @(equipmentList?.Count ?? 0) items</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="md:w-48">
                                    <div class="flex justify-between text-sm mb-1">
                                        <span class="text-gray-600">Bookings:</span>
                                        <span class="font-medium text-blue-600">@bookingCount (@percentage%)</span>
                                    </div>
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" style="width: @percentage%"></div>
                                    </div>
                                    <div class="mt-3 flex justify-between text-xs text-gray-500">
                                        <span>0%</span>
                                        <span>100%</span>
                                    </div>
                                </div>
                            </div>

                            @if (equipmentList != null && equipmentList.Any())
                            {
                                <div class="mt-6 pt-6 border-t border-gray-100">
                                    <h5 class="text-sm font-semibold text-gray-700 mb-3 flex items-center">
                                        <i class="fas fa-tools mr-2 text-gray-500"></i>
                                        Equipment Inventory
                                    </h5>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                                        @foreach (var eq in equipmentList)
                                        {
                                            <div class="bg-gray-50 px-3 py-2 rounded-lg border border-gray-200 text-sm flex items-center">
                                                <i class="fas fa-circle text-xs text-green-500 mr-2"></i>
                                                <span class="truncate">@eq.Name</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 text-center">
                    <i class="fas fa-flask text-4xl text-gray-300 mb-4"></i>
                    <h3 class="text-xl font-medium text-gray-700">No Lab Data Available</h3>
                    <p class="text-gray-500 mt-2">There are currently no labs to display in the report.</p>
                </div>
            }
        </div>
    </div>

    <script>
        // Sample chart initialization (replace with your actual data)
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('bookingChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(labBookings?.Select(item => (item.Lab as AAUP_LabMaster.Models.Lab)?.Name) ?? new List<string>())),
                    datasets: [{
                        label: 'Bookings',
                        @* data: @Html.Raw(Json.Serialize(labBookings?.Select(item => item.BookingCount) ?? new List<int>())), *@
                        backgroundColor: '#3b82f6',
                        borderRadius: 6,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: {
                                size: 14,
                                weight: 'bold'
                            },
                            bodyFont: {
                                size: 12
                            },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                drawBorder: false,
                                color: '#e2e8f0'
                            },
                            ticks: {
                                color: '#64748b'
                            }
                        },
                        x: {
                            grid: {
                                display: false,
                                drawBorder: false
                            },
                            ticks: {
                                color: '#64748b'
                            }
                        }
                    }
                }
            });
        });
    </script>

</body>
</html>